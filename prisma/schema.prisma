generator client {
  provider   = "prisma-client-js"
  engineType = "none"
}

datasource db {
  provider = "postgresql"
}

model User {
  email              String              @unique
  provider           PaymentProvider?
  providerCustomerId String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  dateOfBirth        DateTime?
  name               String?
  roles              String[]            @default(["user"])
  password           String              @default("$2a$10$jeaeQtlxxRmjRqVD/h9HnOC2GANB1oKKPAraPazA81nbgJcpOsIyG")
  id                 String              @id @default(uuid())
  creditTransactions CreditTransaction[]
  creditWallet       CreditWallet?
  payments           Payment[]
  paymentMethods     PaymentMethod[]
  subscription       Subscription?
}

model Product {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plans     Plan[]
}

model Plan {
  id             String          @id @default(cuid())
  code           String
  name           String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  isFree         Boolean         @default(false)
  productId      String
  creditPolicy   CreditPolicy?
  product        Product         @relation(fields: [productId], references: [id])
  pricingOptions PricingOption[]

  @@unique([productId, code])
}

model CreditPolicy {
  id            String        @id @default(cuid())
  planId        String        @unique
  creditAmount  Int
  resetInterval ResetInterval
  intervalDays  Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  plan          Plan          @relation(fields: [planId], references: [id])
}

model BillingCycle {
  id             String          @id @default(cuid())
  name           String
  durationDay    Int
  pricingOptions PricingOption[]
}

model PricingOption {
  id                    String              @id @default(cuid())
  planId                String
  billingCycleId        String
  name                  String
  price                 Decimal
  currency              String
  provider              PaymentProvider?
  providerPriceId       String?
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  productId             String
  billingCycle          BillingCycle        @relation(fields: [billingCycleId], references: [id])
  plan                  Plan                @relation(fields: [planId], references: [id])
  subscriptions         Subscription[]
  subscriptionEventsNew SubscriptionEvent[] @relation("NewPricing")
  subscriptionEventsOld SubscriptionEvent[] @relation("OldPricing")

  @@unique([planId, billingCycleId, currency, provider])
  @@unique([provider, providerPriceId])
  @@unique([id, productId])
}

model Subscription {
  id                           String              @id @default(cuid())
  pricingOptionId              String
  status                       SubscriptionStatus
  currentPeriodStart           DateTime
  currentPeriodEnd             DateTime
  nextCreditResetAt            DateTime
  subscriptionCreditsRemaining Int
  autoRenew                    Boolean             @default(true)
  provider                     PaymentProvider?
  providerSubscriptionId       String?
  cancelledAt                  DateTime?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  trialEnd                     DateTime?
  trialStart                   DateTime?
  userId                       String              @unique
  invoices                     Invoice[]
  pricingOption                PricingOption       @relation(fields: [pricingOptionId], references: [id])
  user                         User                @relation(fields: [userId], references: [id])
  events                       SubscriptionEvent[]
}

model CreditWallet {
  addonCredits Int      @default(0)
  updatedAt    DateTime @updatedAt
  is_active    Boolean  @default(false)
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id])
}

model AddonPackage {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  credits         Int
  price           Decimal
  currency        String
  provider        PaymentProvider?
  providerPriceId String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  payments        Payment[]
}

model Invoice {
  id                String          @id @default(cuid())
  subscriptionId    String
  provider          PaymentProvider
  providerInvoiceId String?         @unique
  amount            Decimal
  currency          String
  status            InvoiceStatus
  retryCount        Int             @default(0)
  nextRetryAt       DateTime?
  dueAt             DateTime
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  billingReason     String?
  subscription      Subscription    @relation(fields: [subscriptionId], references: [id])
  payments          Payment[]
}

model Payment {
  id                String          @id @default(cuid())
  invoiceId         String?
  addonPackageId    String?
  provider          PaymentProvider
  providerPaymentId String          @unique
  amount            Decimal
  currency          String
  status            PaymentStatus
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  userId            String
  addonPackage      AddonPackage?   @relation(fields: [addonPackageId], references: [id])
  invoice           Invoice?        @relation(fields: [invoiceId], references: [id])
  user              User            @relation(fields: [userId], references: [id])
}

model PaymentMethod {
  id                      String          @id @default(cuid())
  provider                PaymentProvider
  providerPaymentMethodId String          @unique
  isDefault               Boolean         @default(false)
  metadata                Json?
  createdAt               DateTime        @default(now())
  brand                   String?
  expMonth                Int?
  expYear                 Int?
  fingerprint             String?
  last4                   String?
  updatedAt               DateTime        @updatedAt
  userId                  String
  user                    User            @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CreditTransaction {
  id             String                @id @default(cuid())
  type           CreditTransactionType
  amount         Int
  description    String?
  referenceType  ReferenceType?
  referenceId    String?
  createdAt      DateTime              @default(now())
  idempotencyKey String?               @unique
  userId         String
  user           User                  @relation(fields: [userId], references: [id])
}

model SubscriptionEvent {
  id                 String                @id @default(cuid())
  subscriptionId     String
  type               SubscriptionEventType
  oldPricingOptionId String?
  newPricingOptionId String?
  metadata           Json?
  createdAt          DateTime              @default(now())
  newPricingOption   PricingOption?        @relation("NewPricing", fields: [newPricingOptionId], references: [id])
  oldPricingOption   PricingOption?        @relation("OldPricing", fields: [oldPricingOptionId], references: [id])
  subscription       Subscription          @relation(fields: [subscriptionId], references: [id])
}

model WebhookEvent {
  id           String             @id
  provider     PaymentProvider
  eventType    String
  payload      Json
  processedAt  DateTime?
  createdAt    DateTime           @default(now())
  attempts     Int                @default(1)
  errorMessage String?
  objectId     String?
  objectType   String?
  status       WebhookEventStatus @default(RECEIVED)
}

model CleanupTask {
  id        String            @id @default(cuid())
  type      CleanupTaskType
  target    String
  status    CleanupTaskStatus @default(PENDING)
  attempts  Int               @default(0)
  lastError String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([type, target])
}

enum WebhookEventStatus {
  RECEIVED
  SUCCESS
  FAILED
  UNHANDLED
}

enum ResetInterval {
  MONTHLY
  EVERY_N_DAYS
}

enum PaymentProvider {
  STRIPE
}

enum CleanupTaskType {
  STRIPE_CUSTOMER
}

enum CleanupTaskStatus {
  PENDING
  DONE
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  TRIALING
  PAUSED
  INCOMPLETE
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CreditTransactionType {
  RENEWAL
  ADDON_PURCHASE
  USAGE
  ADJUSTMENT
  EXPIRATION
  REFUND
}

enum ReferenceType {
  SUBSCRIPTION
  ADDON_PURCHASE
  PAYMENT
  MANUAL
}

enum SubscriptionEventType {
  CREATED
  RENEWED
  UPGRADED
  DOWNGRADED
  CANCELLED
  EXPIRED
  PAUSED
  RESUMED
  PAYMENT_FAILED
  PAYMENT_RECOVERED
  PAYMENT_ACTION_REQUIRED
}
