generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
  engineType      = "none"
}

datasource db {
  provider = "postgresql"
}

model User {
  email              String              @unique
  provider           PaymentProvider?
  providerCustomerId String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  dateOfBirth        DateTime?
  name               String?
  roles              String[]            @default(["user"])
  password           String              @default("$2a$10$jeaeQtlxxRmjRqVD/h9HnOC2GANB1oKKPAraPazA81nbgJcpOsIyG")
  id                 String              @id @default(uuid())
  creditGrants       CreditGrant[]
  creditTransactions CreditTransaction[]
  creditWallets      CreditWallet?
  payments           Payment[]
  paymentMethods     PaymentMethod[]
  subscriptions      Subscription[]
}

model Product {
  id                            String         @id @default(cuid())
  code                          String         @unique
  name                          String
  isActive                      Boolean        @default(true)
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt
  /// Add-on credit của product này có cần một sub live mới tiêu được không (D7).
  /// AI = true: rớt về Free thì add-on grant đóng băng – không tiêu được, không mất.
  /// Đưa vào PR1 (không đợi Bước 5) để PR2 viết gate freeze một lần, khỏi rework.
  addonRequiresLiveSubscription Boolean        @default(true)
  addonPackages                 AddonPackage[]
  creditGrants                  CreditGrant[]
  plans                         Plan[]
}

model Plan {
  id             String          @id @default(cuid())
  code           String
  name           String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  isFree         Boolean         @default(false)
  productId      String
  creditPolicy   CreditPolicy?
  product        Product         @relation(fields: [productId], references: [id])
  pricingOptions PricingOption[]

  @@unique([productId, code])
  @@unique([id, productId])
}

model CreditPolicy {
  id            String        @id @default(cuid())
  planId        String        @unique
  creditAmount  Int
  resetInterval ResetInterval
  intervalDays  Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  plan          Plan          @relation(fields: [planId], references: [id])
}

model BillingCycle {
  id             String          @id @default(cuid())
  name           String
  durationDay    Int
  pricingOptions PricingOption[]
}

model PricingOption {
  id                    String              @id @default(cuid())
  planId                String
  billingCycleId        String
  name                  String
  price                 Decimal
  currency              String
  provider              PaymentProvider?
  providerPriceId       String?
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  productId             String
  invoices              Invoice[]
  billingCycle          BillingCycle        @relation(fields: [billingCycleId], references: [id])
  plan                  Plan                @relation(fields: [planId, productId], references: [id, productId])
  subscriptions         Subscription[]
  subscriptionEventsNew SubscriptionEvent[] @relation("NewPricing")
  subscriptionEventsOld SubscriptionEvent[] @relation("OldPricing")

  @@unique([planId, billingCycleId, currency, provider])
  @@unique([provider, providerPriceId])
  @@unique([id, productId])
}

model Subscription {
  id                 String             @id @default(cuid())
  pricingOptionId    String
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  nextCreditResetAt  DateTime
  autoRenew          Boolean            @default(true)
  provider           PaymentProvider?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // ─── EXPAND: cột mới, chưa có implementation cho tới PR3 (Dev B) ───

  /// Denormalize từ pricingOption.plan.productId để làm partial unique index
  /// `(userId, productId) WHERE status IN ('ACTIVE','PAST_DUE')` (§13.1) — Postgres không
  /// index xuyên join nên cột này phải nằm vật lý trên row.
  /// NOT NULL từ 20260717050000: để nullable thì NULL là DISTINCT trong unique index nên
  /// index hoá trơ, và composite FK dưới đây là MATCH SIMPLE nên hàng NULL né FK hoàn toàn.
  productId   String
  /// Row Free = NONE (không Stripe sub phía sau), Enterprise = MANUAL (thay A10).
  billingMode BillingMode @default(PROVIDER)

  // ─── CONTRACT: sẽ xoá ở PR4, giữ để branch luôn compile ───

  /// @deprecated Số dư dời sang CreditGrant. PR2 (Dev A) chuyển implementation, PR4 xoá.
  /// `@default(0)` để code mới của PR3 khỏi phải điền một cột đã chết.
  subscriptionCreditsRemaining Int       @default(0)
  /// @deprecated D12 bỏ trial hoàn toàn. Xoá ở PR4.
  trialEnd                     DateTime?
  trialStart                   DateTime?

  /// @unique giữ tới PR3: bỏ bây giờ làm vỡ 27 chỗ trong src/credits (call-site mà PR2
  /// sẽ tự xoá) và ép User.subscription thành 1-n. Dev B drop ở PR3 khi đã sạch.
  userId String

  providerSubscriptionId String?
  invoices               Invoice[]
  // Composite FK, KHÔNG phải FK đơn `pricingOptionId`: FK đơn để `productId` trôi tự do khỏi
  // pricingOption.plan.productId, tức cột chống lưng cho partial unique index §13.1 có thể
  // nói dối. Composite thì DB từ chối — không có PricingOption nào (id=X, productId=Y) lệch.
  // Cùng pattern PricingOption→Plan ở trên. Đòi unique PricingOption(id, productId).
  pricingOption          PricingOption       @relation(fields: [pricingOptionId, productId], references: [id, productId])
  user                   User                @relation(fields: [userId], references: [id])
  events                 SubscriptionEvent[]

  @@unique([provider, providerSubscriptionId])
  @@unique([userId, productId], map: "Subscription_live_user_product_key", where: raw("(status = 'ACTIVE'::\"SubscriptionStatus\")"))
}

model CreditWallet {
  addonCredits Int      @default(0)
  updatedAt    DateTime @updatedAt
  is_active    Boolean  @default(false)
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id])
}

model CreditGrant {
  id              String                @id @default(cuid())
  userId          String
  productId       String
  sourceType      CreditGrantSourceType
  sourceRef       String?
  amountGranted   Int
  amountRemaining Int
  expiresAt       DateTime?
  priority        Int                   @default(100)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  product         Product               @relation(fields: [productId], references: [id])
  user            User                  @relation(fields: [userId], references: [id])
  transactions    CreditTransaction[]

  @@index([userId, productId])
}

model AddonPackage {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  credits         Int
  price           Decimal
  currency        String
  provider        PaymentProvider?
  providerPriceId String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  productId       String?
  product         Product?         @relation(fields: [productId], references: [id])
  payments        Payment[]
}

model Invoice {
  id                 String              @id @default(cuid())
  subscriptionId     String
  provider           PaymentProvider
  providerInvoiceId  String?             @unique
  amount             Decimal
  currency           String
  status             InvoiceStatus
  retryCount         Int                 @default(0)
  nextRetryAt        DateTime?
  dueAt              DateTime
  paidAt             DateTime?
  createdAt          DateTime            @default(now())
  billingReason      String?
  /// EXPAND: snapshot giá tại thời điểm charge (§8, D10). Row bất biến theo Stripe sub ID
  /// nhưng KHÔNG bất biến theo pricing (đổi chu kỳ đổi pricingOptionId), nên "invoice này
  /// theo giá nào" phải đọc từ chính Invoice. PR3 (Dev B) populate.
  pricingOptionId    String?
  creditTransactions CreditTransaction[]
  pricingOption      PricingOption?      @relation(fields: [pricingOptionId], references: [id])
  subscription       Subscription        @relation(fields: [subscriptionId], references: [id])
  payments           Payment[]
}

model Payment {
  id                String          @id @default(cuid())
  invoiceId         String?
  addonPackageId    String?
  provider          PaymentProvider
  providerPaymentId String          @unique
  amount            Decimal
  currency          String
  status            PaymentStatus
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  userId            String
  addonPackage      AddonPackage?   @relation(fields: [addonPackageId], references: [id])
  invoice           Invoice?        @relation(fields: [invoiceId], references: [id])
  user              User            @relation(fields: [userId], references: [id])
}

model PaymentMethod {
  id                      String          @id @default(cuid())
  provider                PaymentProvider
  providerPaymentMethodId String          @unique
  isDefault               Boolean         @default(false)
  metadata                Json?
  createdAt               DateTime        @default(now())
  brand                   String?
  expMonth                Int?
  expYear                 Int?
  fingerprint             String?
  last4                   String?
  updatedAt               DateTime        @updatedAt
  userId                  String
  user                    User            @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CreditTransaction {
  id             String                @id @default(cuid())
  type           CreditTransactionType
  amount         Int
  description    String?
  /// Trỏ vào ENTITY: với credit subscription thì referenceId = subscription.id, không phải
  /// invoice.id. Hoá đơn đi vào `invoiceId` bên dưới.
  referenceType  ReferenceType?
  referenceId    String?
  createdAt      DateTime              @default(now())
  /// Constraint quan trọng nhất hệ thống – không đụng (§13.6).
  idempotencyKey String?               @unique
  userId         String
  /// EXPAND: nullable ở PR1 vì implementation cũ vẫn ghi transaction không có grant.
  /// Spec muốn NOT NULL — siết ở PR4 sau khi PR2 chuyển xong mọi đường ghi.
  grantId        String?
  /// EVENT đã kích hoạt bút toán này. Invoice không phải entitlement, không phải identity
  /// của grant — nó là cái làm việc cấp credit xảy ra, nên nó thuộc về sổ. Nullable vì
  /// reset cron và adjust không sinh ra từ hoá đơn nào.
  invoiceId      String?
  grant          CreditGrant?          @relation(fields: [grantId], references: [id])
  invoice        Invoice?              @relation(fields: [invoiceId], references: [id])
  user           User                  @relation(fields: [userId], references: [id])

  @@index([grantId])
  @@index([invoiceId])
}

model SubscriptionEvent {
  id                 String                @id @default(cuid())
  subscriptionId     String
  type               SubscriptionEventType
  oldPricingOptionId String?
  newPricingOptionId String?
  metadata           Json?
  createdAt          DateTime              @default(now())
  newPricingOption   PricingOption?        @relation("NewPricing", fields: [newPricingOptionId], references: [id])
  oldPricingOption   PricingOption?        @relation("OldPricing", fields: [oldPricingOptionId], references: [id])
  subscription       Subscription          @relation(fields: [subscriptionId], references: [id])
}

model WebhookEvent {
  id           String             @id
  provider     PaymentProvider
  eventType    String
  payload      Json
  processedAt  DateTime?
  createdAt    DateTime           @default(now())
  attempts     Int                @default(1)
  errorMessage String?
  objectId     String?
  objectType   String?
  status       WebhookEventStatus @default(RECEIVED)
}

model CleanupTask {
  id        String            @id @default(cuid())
  type      CleanupTaskType
  target    String
  status    CleanupTaskStatus @default(PENDING)
  attempts  Int               @default(0)
  lastError String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([type, target])
}


enum WebhookEventStatus {
  RECEIVED
  SUCCESS
  FAILED
  UNHANDLED
}

enum ResetInterval {
  MONTHLY
  EVERY_N_DAYS
}

enum CreditGrantSourceType {
  SUBSCRIPTION_ALLOCATION
  SUBSCRIPTION_RESET
  ADDON
  GIFT
  PROMOTION
  ADMIN
}

/// Mở đường cho Enterprise (hoá đơn tay) và là mode của row Free (thay A10).
enum BillingMode {
  PROVIDER
  MANUAL
  NONE
}

enum PaymentProvider {
  STRIPE
}

enum CleanupTaskType {
  STRIPE_CUSTOMER
}

enum CleanupTaskStatus {
  PENDING
  DONE
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  TRIALING
  PAUSED
  INCOMPLETE
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CreditTransactionType {
  RENEWAL
  ADDON_PURCHASE
  USAGE
  ADJUSTMENT
  EXPIRATION
  REFUND
}

enum ReferenceType {
  SUBSCRIPTION
  ADDON_PURCHASE
  PAYMENT
  MANUAL
}

enum SubscriptionEventType {
  CREATED
  RENEWED
  UPGRADED
  DOWNGRADED
  CANCELLED
  EXPIRED
  PAUSED
  RESUMED
  PAYMENT_FAILED
  PAYMENT_RECOVERED
  PAYMENT_ACTION_REQUIRED
}

